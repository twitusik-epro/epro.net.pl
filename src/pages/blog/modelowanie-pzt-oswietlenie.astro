    .tech-btn { color: #00f0ff; font-family: 'Chakra Petch', sans-serif; font-weight: 600; font-size: 0.8rem; border: 1px solid rgba(0, 240, 255, 0.3); padding: 5px 15px; background: rgba(0, 240, 255, 0.05); text-decoration: none; }
    .article-container { max-width: 800px; margin: 60px auto; padding: 50px; background: rgba(11, 30, 51, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05); position: relative; }
    .article-container::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, #00f0ff, transparent); }
